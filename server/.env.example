# ---------------------------------------------------------------------------
# Classroom Notes backend configuration.
# Copy to .env and fill in the secrets. NEVER put these values in the client.
# ---------------------------------------------------------------------------

# ASR provider: deepgram | google | azure | fake
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Deepgram streaming model. nova-2 covers zh/en/ru; nova-3 is en-focused.
DEEPGRAM_MODEL=nova-2
# Fallback when the client asks for "auto" and auto detection is unavailable.
ASR_DEFAULT_LANGUAGE=zh
# Deepgram endpointing (ms). The client sends `flush` after ~1.5 s of silence.
ASR_ENDPOINTING_MS=1500
ASR_UTTERANCE_END_MS=1500

# Translation provider: deepl | none
TRANSLATE_PROVIDER=deepl
DEEPL_API_KEY=
# Free keys: https://api-free.deepl.com  •  Pro keys: https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com

# WebSocket server
WS_HOST=0.0.0.0
WS_PORT=8000
LOG_DIR=logs

# Kill the upstream ASR socket after this many idle seconds (0 = keep alive).
ASR_IDLE_DISCONNECT_S=0
